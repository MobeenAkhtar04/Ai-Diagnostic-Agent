# Copy to .env and fill in ONE provider. Set a hard spend cap in the provider console first.

# Anthropic
ANTHROPIC_API_KEY=
# DIAG_MODEL=claude-haiku-5-5

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# DIAG_MODEL=<model name>

# Ollama (local, free): `ollama pull qwen2.5:7b` then use --llm ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Cost tracking: your model's price in USD per million tokens (check the provider's pricing page)
# PRICE_IN_PER_MTOK=0
# PRICE_OUT_PER_MTOK=0
